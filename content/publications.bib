@article{zhao2026ceusborder,
  selected={true},
  title = {A Representation-Explanation Framework for Flow-Based Border Effects on Intra-Urban Commuting Using Geographically Weighted Additive Gravity Model and Machine Learning},
  author = {Junyang Zhao and Zhaodong Zhang and Xixiang Wen and Mengwei Xin and Yongxi Gong# and Yu Liu#},
  year = {2026},
  month = mar,
  journal = {Computers, Environment and Urban Systems},
  volume = {nan},
  pages = {nan},
  issn = {nan},
  doi = {nan},
  urldate = {nan},
  langid = {english},
  abstract = {Border effects suppress cross-boundary flows of people and goods, and it is precisely this suppression that drives the gradual divergence of built environment and socioeconomic conditions on either side of a boundary. Measuring border effects from flows is therefore more proximate to the border effect itself than inferring them from downstream outcomes such as housing price differentials or service provision gaps. To address the challenge that flow-based border effects are inherently unobservable and thus unable to be systematically characterized, this study proposes a representation-explanation framework. In the representation stage, a flow-based geographically weighted additive gravity model (FB-GWAGM) that treats each border crossing as an additive increment to physical distance is adopted. In the explanation stage, weighted random forest models with SHapley Additive exPlanations analysis identify the built environment and socioeconomic factors affecting border thickness. On the basis of the modeling results, the spatial heterogeneity of border thickness is identified and quantified in distance-equivalent units, and the contributions of built environment and socioeconomic factors to this heterogeneity are decomposed in the same metric, enabling direct comparison across border types and factor dimensions. These findings demonstrate that the representation-explanation framework provides a replicable and physically interpretable approach to quantifying flow-based border effects, advancing the understanding of how borders shape spatial interaction within cities and revealing the socioeconomically contingent nature of border thickness heterogeneity.},
  preview={example.png},  
  description = {Develops a framework to quantify border effects as distance-equivalent border thickness and explain their spatial heterogeneity.},
  keywords={intra-urban commuting, border effect, representation-explanation framework, geographically weighted additive gravity model}
}

@inproceedings{zhao2025isocarpenergy,
  selected={true},
  title = {Assessing the Impact of Urban Residential Morphology on the Seasonal Variation of Building Energy Consumption in Severely Cold Regions: Evidence from Harbin, China},
  booktitle = {61st ISOCARP World Planning Congress},
  author = {Junyang Zhao and Haoting Tang and Lulu Chen#},
  year = {2025},
  month = jan,
  pages = {205--218},
  publisher = {EMS Press},
  address = {Paris, France},
  doi = {10.47472/9dcKkyR8},
  urldate = {2028-08-17},
  isbn = {978-3-03719-202-8},
  abstract = {Urban residential areas are major contributors to building energy consumption and are strongly shaped by their spatial morphological characteristics. In severely cold regions, extreme heating demands in winter and cooling needs in summer produce pronounced seasonal differences in residential energy use. Understanding how urban residential morphology drives these seasonal variations is essential for low-carbon urban planning and climate-resilient neighborhood design. This study focuses on Harbin, China, and investigates 15 sampled residential areas across three seasonal periods — winter (November–December), summer (July–August), and transitional season (September–October) — defined by regional climatic patterns. A multi-source spatial morphology database of 26 indicators was developed. Honeybee and EnergyPlus were used to simulate neighborhood-scale energy use intensity (EUI) for each season. Spearman's correlation analysis identified Spatial Morphology Key Factors (SMKFs) per season, which were then entered into three multiple linear regression models. Results show that: (1) FAR, building layout pattern, and building density are significantly correlated with residential energy use across all seasons; (2) EUI varies markedly among the three periods, confirming the seasonal nature of energy demand; and (3) distinct sets of spatial morphology factors drive energy use in each season. These findings provide an evidence base for seasonally differentiated, morphology-sensitive planning strategies that support climate resilience in severely cold urban regions.},
  preview={example.png},
  description={Assesses the impact of urban residential morphology on seasonal building energy consumption in severely cold regions.},
  keywords={Urban Planning, Energy Consumption, Seasonal Variation, Residential Morphology, Cold Climates}
}

@inproceedings{brown2023monte,
  selected={false},
  title = {Monte Carlo Simulations of Phase Transitions in 2D Ising Models on Non-Euclidean Lattices},
  shorttitle = {Ising on Hyperbolic Planes},
  booktitle = {2023 International Conference on Computational Physics (ICCP)},
  author = {Charlie Brown and Jiale Liu*},
  year = {2023},
  month = dec,
  pages = {45--52},
  publisher = {APS},
  address = {Tokyo, Japan},
  doi = {10.1103/ICCP.2023.0045},
  urldate = {2028-08-17},
  isbn = {978-0-7354-2000-1},
  abstract = {The behavior of spin systems on curved geometries offers a unique window into the interplay between topology and statistical mechanics. This study employs extensive Monte Carlo simulations to explore the phase transitions of the 2D Ising model mapped onto hyperbolic lattices (Poincaré disk). We utilize the Wolff cluster algorithm to overcome critical slowing down near the phase transition temperature. Our results indicate that the critical exponents on negatively curved surfaces deviate significantly from the standard Onsager solution for flat Euclidean lattices. Specifically, we observe a suppression of the correlation length divergence, suggesting a mean-field-like behavior induced by the exponential expansion of the lattice volume. These findings have implications for understanding quantum gravity models and holographic duality.},
  preview={example.png},
  description={Monte Carlo study revealing mean-field-like phase transitions and critical exponent deviations for Ising models on hyperbolic non-Euclidean lattices.},
  keywords={Statistical Mechanics, Monte Carlo Simulation, Ising Model, Non-Euclidean Geometry}
}

@article{doe2025existence,
  title = {On the Existence and Uniqueness of Solutions to Non-Linear Stochastic Partial Differential Equations},
  author = {Jane Doe and Jiale Liu and Richard Feynman},
  year = {2025},
  month = jun,
  journal = {Annals of Probability},
  volume = {53},
  number = {4},
  pages = {1201--1245},
  issn = {0091-1798},
  doi = {10.1214/25-AOP1201},
  copyright = {https://imstat.org/journals-and-publications/annals-of-probability/},
  abstract={We establish the existence and uniqueness of strong solutions for a class of non-linear Stochastic Partial Differential Equations (SPDEs) driven by multiplicative Lévy noise. The equations under consideration model turbulent fluid flow and heat transport in random media. By employing a Galerkin approximation scheme combined with a compact embedding theorem, we prove the convergence of the approximate solutions in appropriate Hilbert spaces. Furthermore, we derive a priori estimates that ensure the global regularity of the solution almost surely. A key contribution of this work is the treatment of non-Lipschitz coefficients using a stochastic Gronwall inequality, extending the applicability of the theory to more singular physical models. We also discuss the ergodic properties of the invariant measures associated with the SPDEs.},
  preview={example.png},
  description={Mathematical proof of existence and uniqueness for non-linear SPDEs with multiplicative Lévy noise, extending theory to non-Lipschitz coefficients.},
  keywords={Stochastic Analysis, SPDE, Existence Theorems, Probability Theory}
}
